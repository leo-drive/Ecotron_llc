<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<hightec_project_settings eclipse_build_date="2013.09">
  <project_build_properties>
    <pre_post_build_streps>
      <pre_build_step/>
      <post_build_step>
        <build_step active="true" command="${activeToolchain}/bin/${archToolPref}-objcopy" description="The tool objcopy supports different output formats. To generate an Intel Hex format, you can use this post build step" errRedirection="${ProjDirPath}/${ConfigName}/hexError.txt" errRedirectionAppend="false" errRedirectionEnabled="false" name="Generate hex" outRedirection="${ProjDirPath}/${ConfigName}/hex.txt" outRedirectionAppend="false" outRedirectionEnabled="true" position="0">
          <argument value="-O"/>
          <argument value="ihex"/>
          <argument value="${BuildArtifactFileBaseName}.elf"/>
          <argument value="${BuildArtifactFileBaseName}.hex"/>
        </build_step>
        <build_step active="true" command="${activeToolchain}/bin/${archToolPref}-objcopy" description="The tool objcopy can be used to generate S-records by using an output target of srec" errRedirection="${ProjDirPath}/${ConfigName}/srecError.txt" errRedirectionAppend="false" errRedirectionEnabled="false" name="Generate srec" outRedirection="${ProjDirPath}/${ConfigName}/srec.txt" outRedirectionAppend="false" outRedirectionEnabled="true" position="1">
          <argument value="-O"/>
          <argument value="srec"/>
          <argument value="${BuildArtifactFileBaseName}.elf"/>
          <argument value="${BuildArtifactFileBaseName}.srec"/>
        </build_step>
      </post_build_step>
    </pre_post_build_streps>
  </project_build_properties>
</hightec_project_settings>
