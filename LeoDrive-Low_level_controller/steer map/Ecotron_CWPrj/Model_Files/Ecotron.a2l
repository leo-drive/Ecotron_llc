    /begin GROUP 
      /* Name                   */       Ecotron
      /* Long identifier        */       "Ecotron"
      /* Root                    */       ROOT
      /begin SUB_GROUP
        Root_Input
        Root_Main_
        Root_Power_Management_Example
        Root_Subsystem4
      /end SUB_GROUP
      /begin REF_CHARACTERISTIC
        CANA_recover
        CANB_recover
        CANC_recover
      /end REF_CHARACTERISTIC
    /end GROUP
    
    /begin GROUP 
      /* Name                   */       Root_Input
      /* Long identifier        */       "Ecotron/Input"
      /begin SUB_GROUP
        S2_By_wire
        S2_Golf
        S2_PC
      /end SUB_GROUP
    /end GROUP
    
